# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables (then redeploy).
# Find them in Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Server-side only (no REACT_APP_ prefix) — used by api/claude.js
ANTHROPIC_API_KEY=
