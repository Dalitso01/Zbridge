rules_version = '2';

// ZBRIDGE database rules.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function shortText(field, max) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() > 0
        && request.resource.data[field].size() <= max;
    }

    // Each student can only see and change their own profile.
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Tester feedback: anyone can send it, nobody can read it from the site.
    // Read it in the Firebase console → Firestore Database → feedback.
    match /feedback/{id} {
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && (request.resource.data.rating == null
            || (request.resource.data.rating is int
                && request.resource.data.rating >= 1
                && request.resource.data.rating <= 5));
      allow read, update, delete: if false;
    }

    // Forum: everyone can read; signed-in members post under their own account.
    match /forumTopics/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && shortText("title", 140)
        && shortText("content", 4000)
        && shortText("authorName", 80);
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /forumReplies/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && shortText("text", 2000)
        && shortText("topicId", 100)
        && shortText("authorName", 80);
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    // Everything else is closed until we add rules for it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
